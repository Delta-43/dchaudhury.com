---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
  footerContact?: boolean;
  noindex?: boolean;
}

const { title, description, canonical, jsonLd, footerContact = true, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/\/index$/, '/')
  .replace(/(.)\/$/, '$1');
const canonicalUrl = new URL(canonical ?? path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk/schibsted-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: software, data, bioinformatics, teaching and writing`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter showContact={footerContact} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--space-3);
    inset-block-start: -100px;
    z-index: 10;
    padding: var(--space-2) var(--space-3);
    background: var(--color-text);
    color: var(--color-bg);
  }

  .skip:focus {
    inset-block-start: var(--space-3);
  }

  main:focus {
    outline: none;
  }
</style>
