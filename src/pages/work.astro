---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const entries = await Promise.all(projects.map(async (project) => ({ project, ...(await render(project)) })));
---

<Base
  title="Work"
  description="Projects by Debadeep Chaudhury: three 2026 hackathon placings, an AI rules agent, Pebble apps, genomics teaching guides, a homelab and a design library."
>
  <div class="page-head wrap">
    <h1>Work</h1>
    <p class="lead">Hackathon projects and my own tools from 2026. Each one says what I did and what it runs on.</p>
  </div>

  <div class="wrap">
    {
      entries.map(({ project, Content }, index) => {
        const { data } = project;
        return (
          <article class="project" aria-labelledby={project.id}>
            <header class="project-head">
              <p class="label muted">
                {String(index + 1).padStart(2, '0')}
                {data.dates && <> · {data.dates}</>}
              </p>
              <h2 id={project.id}>{data.title}</h2>
              {data.event && <p class="label">{data.event}</p>}
            </header>
            <div class="project-body">
              <p class="summary">{data.summary}</p>
              <p>{data.role}</p>
              <div class="details">
                <Content />
              </div>
              {data.figure && (
                <p class="figure">
                  <span class="value">{data.figure.value}</span>
                  <span class="muted">{data.figure.label}</span>
                </p>
              )}
              <ul class="stack label muted" aria-label="Stack">
                {data.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {(data.links.length > 0 || data.note) && (
                <div class="project-links">
                  {data.links.length > 0 && (
                    <ul class="links">
                      {data.links.map((link) => (
                        <li>
                          <a href={link.href}>
                            {link.label}
                            <span class="visually-hidden">: {data.title}</span>
                            <Icon name="arrow-up-right" />
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {data.note && <p class="muted">{data.note}</p>}
                </div>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Base>

<style>
  .project {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-block-start: 1px solid var(--color-border);
  }

  .project-head {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-line);
    letter-spacing: var(--text-2xl-tracking);
    overflow-wrap: anywhere;
  }

  .project-body {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--measure);
  }

  .summary {
    font-size: var(--text-lg);
    line-height: var(--text-lg-line);
    letter-spacing: var(--text-lg-tracking);
  }

  .details :global(ul) {
    padding-inline-start: 1.1em;
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
  }

  .figure {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .figure .value {
    font-size: var(--text-xl);
    line-height: var(--text-xl-line);
    letter-spacing: var(--text-xl-tracking);
  }

  .stack {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .project-links {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 60rem) {
    .project {
      grid-template-columns: 4fr 8fr;
      gap: var(--space-6);
    }
  }
</style>
